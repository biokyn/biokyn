{
  "name": "@biokyn/server",
  "version": "1.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "author": "NodeX-AR",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biokyn/biokyn.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/biokyn/biokyn#readme",
  "bugs": {
    "url": "https://github.com/biokyn/biokyn/issues"
  },
  "keywords": [
    "bot-mitigation",
    "captcha-alternative",
    "privacy-pass",
    "voprf",
    "webauthn",
    "argon2",
    "proof-of-work",
    "self-hosted"
  ],
  "description": "BioKyn verifier with challenge handling, replay protection, siteverify compatibility, and Express/Next.js adapters; cryptographic review required before production use.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.js"
    },
    "./next": {
      "types": "./dist/middleware/next.d.ts",
      "import": "./dist/middleware/next.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:redis": "node ../../scripts/with-env.mjs REQUIRE_REDIS=1 -- vitest run test/redis.integration.test.ts"
  },
  "dependencies": {
    "@biokyn/protocol": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ioredis": "^6.0.0",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
